# --- Salesforce authentication (pick ONE option) ---

# Option 1 (recommended for devs): reuse an org you already logged into with the Salesforce CLI
#   sf org login web --alias my-dev-org
SF_TARGET_ORG=my-dev-org

# Option 2: access token + instance URL
# SF_INSTANCE_URL=https://yourdomain.my.salesforce.com
# SF_ACCESS_TOKEN=00D...

# Option 3: username + password + security token
# SF_USERNAME=you@example.com
# SF_PASSWORD=your-password
# SF_SECURITY_TOKEN=your-security-token
# SF_DOMAIN=login        # use "test" for sandboxes

# --- Safety ---
# Writes (create/update) are blocked unless this is true. Even then, every write needs confirm=true.
SF_ALLOW_WRITES=false
# Max rows returned by a SOQL query (a LIMIT is added automatically when missing)
SF_MAX_ROWS=200

# --- RAG ---
CHROMA_PATH=.chroma

# --- Chat agent ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
